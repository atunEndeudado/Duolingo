generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NivelCurso {
  A1
  A2
  B1
  B2
  C1
}

model Usuario {
  id                    String   @id @default(cuid())
  email                 String   @unique
  nombre                String
  xpTotal               Int      @default(0) @map("xp_total")
  rachaDias             Int      @default(0) @map("racha_dias")
  fechaUltimaActividad  DateTime? @map("fecha_ultima_actividad")
  fechaCreacion         DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion    DateTime @updatedAt @map("fecha_actualizacion")

  cursos                UsuarioCurso[]
  progresos             Progreso[]
  usuarioInsignias      UsuarioInsignia[]
  amistades             Amistad[] @relation("UsuarioAmistades")
  amistadesRecibidas    Amistad[] @relation("UsuarioAmistadesRecibidas")

  @@map("usuarios")
}

model Idioma {
  id          String   @id @default(cuid())
  nombre      String   @unique
  codigo      String   @unique
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  cursos      Curso[]

  @@map("idiomas")
}

model Curso {
  id          String   @id @default(cuid())
  idiomaId    String   @map("idioma_id")
  nivel       NivelCurso
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  idioma      Idioma   @relation(fields: [idiomaId], references: [id])
  lecciones   Leccion[]
  usuarios    UsuarioCurso[]

  @@map("cursos")
}

model Leccion {
  id              String   @id @default(cuid())
  cursoId         String   @map("curso_id")
  orden           Int
  titulo          String
  xpRecompensa    Int      @map("xp_recompensa")
  fechaCreacion   DateTime @default(now()) @map("fecha_creacion")

  curso           Curso    @relation(fields: [cursoId], references: [id])
  progresos       Progreso[]

  @@unique([cursoId, orden])
  @@map("lecciones")
}

model Progreso {
  id               String   @id @default(cuid())
  usuarioId         String   @map("usuario_id")
  leccionId        String   @map("leccion_id")
  puntaje          Int      @default(0)
  completada       Boolean  @default(false)
  fecha            DateTime @default(now())
  fechaCompletada  DateTime? @map("fecha_completada")

  usuario          Usuario  @relation(fields: [usuarioId], references: [id])
  leccion          Leccion @relation(fields: [leccionId], references: [id])

  @@unique([usuarioId, leccionId])
  @@map("progresos")
}

model Insignia {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String
  criterio    String
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  usuarios    UsuarioInsignia[]

  @@map("insignias")
}

model UsuarioCurso {
  usuarioId       String   @map("usuario_id")
  cursoId         String   @map("curso_id")
  fechaInscripcion DateTime @default(now()) @map("fecha_inscripcion")

  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso           Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, cursoId])
  @@map("usuario_cursos")
}

model UsuarioInsignia {
  usuarioId    String   @map("usuario_id")
  insigniaId   String   @map("insignia_id")
  fecha        DateTime @default(now())

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  insignia     Insignia @relation(fields: [insigniaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, insigniaId])
  @@map("usuario_insignias")
}

model Amistad {
  usuarioAId   String   @map("usuario_a_id")
  usuarioBId   String   @map("usuario_b_id")
  fecha        DateTime @default(now())

  usuarioA     Usuario  @relation("UsuarioAmistades", fields: [usuarioAId], references: [id], onDelete: Cascade)
  usuarioB     Usuario  @relation("UsuarioAmistadesRecibidas", fields: [usuarioBId], references: [id], onDelete: Cascade)

  @@id([usuarioAId, usuarioBId])
  @@map("amistades")
}
